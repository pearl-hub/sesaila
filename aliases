#@@ Aliases
#@@@@@@@@@@@@@@@@@@

alias ..="cd .."
alias ...="cd ../.."
alias "c.."="cd .."
alias "c-"="cd -"
alias "c~"="cd $HOME"
alias "cd-"="cd -"

# Mini-aliases :)
alias j="jobs"
alias f="fg"
alias b="bg"
alias q="exit"

alias d="date"
alias p='pwd'
alias h='hostname'

alias t='eza --tree --long --icons --git'
alias t1='t --level=1'
alias t2='t --level=2'
alias t3='t --level=3'

alias ll="ls -l"
alias la="ll -a"

# Allows to keep aliases in sudo
alias sudo="sudo "
# Useful to keep variables environment when you are root
#alias sudo="sudo -E"

# ping the DNS google
alias goo="ping 8.8.8.8"
alias goog="ping www.google.com"

# Grep-based aliases
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias pgrep2="ps -ef | grep"
alias hgrep='history | grep'

alias cal2='cal -3 -m'
alias calc='bc -li'
